# Backend environment (secrets only — never commit real values).
# Generate the Ed25519 seed with: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"

APP_ENV=production

# Allowed frontend origins (CORS whitelist). MUST be a JSON array — pydantic-settings 2.x
# does NOT parse comma-separated lists from env. Use: ["https://a","https://b"]
# Only list domains that actually resolve (add "www." only if you create that record).
FRONTEND_ORIGINS=["https://video2text.dpdns.org"]

# Database. SQLite for dev/small deployments; switch to Postgres URL in production.
DB_URL=sqlite:///./data/app.db

# JWT (HS256) signing secret for user sessions.
JWT_SECRET=

# Ed25519 private key (base64 of 32 raw bytes). The matching public key is
# embedded in the desktop client. Rotate only with a coordinated client release.
LICENSE_ED25519_PRIVATE_KEY=

# Paddle (Merchant of Record).
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
PADDLE_VENDOR_ID=

# Transactional email (Resend by default; see mail_service).
MAIL_API_KEY=
MAIL_FROM=licensing@video2text.dpdns.org

# Rate limit for license activation per IP (single-worker only).
ACTIVATION_RATE_LIMIT_PER_IP=20

# GitHub integration (optional). Personal access token (classic) for higher
# API rate limits when querying repo stars. Leave empty for unauthenticated.
GITHUB_TOKEN=
GITHUB_CACHE_TTL_SECONDS=300
