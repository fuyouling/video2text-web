---
import { getRelativeLocaleUrl } from '../i18n/utils';
import type { Props as SEOProps } from '../components/SEOHead.astro';
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

type Props = SEOProps;

const { lang, path, ...seo } = Astro.props;
const homePath = getRelativeLocaleUrl(lang, '');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="video2text blog" href={getRelativeLocaleUrl(lang, 'blog')} />
    <SEOHead lang={lang} path={path} {...seo} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href={homePath} class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white">
      video2text
    </a>
    <Header lang={lang} path={path} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
