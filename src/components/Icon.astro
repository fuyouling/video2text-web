} as const;

const { name, class: klass = "w-5 h-5", size = 24, strokeWidth = 2 } = Astro.props;
const path = icons[name];
const cls = `inline-block shrink-0 ${klass}`;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={`<g>${path}</g>`}
/>
