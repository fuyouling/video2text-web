---
import { getRelativeLocaleUrl } from "../i18n/utils";
import { useTranslations } from "../i18n/utils";
import { PUBLIC_RELEASE_REPO } from "../lib/env";
import type { Lang } from "../i18n/ui";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const releasesUrl = `https://github.com/${PUBLIC_RELEASE_REPO}/releases`;
---

<section class="relative overflow-hidden bg-gradient-to-b from-brand-50 to-white">
  <div class="container-page grid items-center gap-12 py-16 xl:grid-cols-2 xl:py-24">
    <div>
      <span
        class="inline-flex items-center gap-1.5 rounded-full bg-brand-100 px-3 py-1 text-sm font-medium text-brand-700"
      >
        <Icon name="shield" class="w-4 h-4" />
        {t("hero.badge")}
      </span>
      <h1 class="h-hero mt-5 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        {t("hero.title")}
      </h1>
      <p class="lede mt-5 max-w-xl text-lg text-slate-600">{t("hero.subtitle")}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={releasesUrl}
          class="no-jitter inline-flex items-center gap-2 whitespace-nowrap rounded-lg bg-brand-600 px-5 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-brand-700"
        >
          <Icon name="download" class="w-5 h-5" />
          {t("hero.ctaPrimary")}
        </a>
        <a
          href={getRelativeLocaleUrl(lang, "docs")}
          class="no-jitter inline-flex items-center gap-2 whitespace-nowrap rounded-lg border border-slate-300 bg-white px-5 py-3 text-base font-semibold text-slate-700 transition hover:border-slate-400"
        >
          <Icon name="fileText" class="w-5 h-5" />
          {t("hero.ctaSecondary")}
        </a>
      </div>
    </div>

    <div class="relative">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xl">
        <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
          <span class="h-3 w-3 rounded-full bg-red-400"></span>
          <span class="h-3 w-3 rounded-full bg-yellow-400"></span>
          <span class="h-3 w-3 rounded-full bg-green-400"></span>
          <span class="ml-2 text-xs text-slate-400">video2text</span>
          <span
            class="ml-auto inline-flex items-center gap-1 rounded-full bg-accent-500/10 px-2 py-0.5 text-xs font-medium text-accent-600"
          >
            <Icon name="zap" class="w-3.5 h-3.5" /> {t("hero.bench.title")}
          </span>
        </div>

        <div class="mt-4 space-y-4">
          <div class="rounded-xl bg-brand-50 p-4">
            <div class="flex items-center justify-between gap-2">
              <span class="text-sm font-semibold text-slate-700">{t("hero.bench.model")}</span>
              <code class="rounded bg-white px-2 py-0.5 text-xs font-medium text-brand-700"
                >large-v3-turbo-ct2</code
              >
            </div>
            <div class="mt-3 space-y-2.5">
              <div class="flex items-center gap-3 text-sm">
                <span class="flex w-20 items-center gap-2 text-slate-600">
                  <Icon name="languages" class="w-4 h-4 text-brand-600" />
                  {t("hero.bench.english")}
                </span>
                <span class="flex-1 pl-15 text-slate-400">{t("hero.bench.hour")}</span>
                <span class="w-24 font-semibold text-slate-900">~1.65 {t("hero.bench.min")}</span>
              </div>
              <div class="flex items-center gap-3 text-sm">
                <span class="flex w-20 items-center gap-2 text-slate-600">
                  <Icon name="languages" class="w-4 h-4 text-brand-600" />
                  {t("hero.bench.chinese")}
                </span>
                <span class="flex-1 pl-15 text-slate-400">{t("hero.bench.hour")}</span>
                <span class="w-24 font-semibold text-slate-900">~5 {t("hero.bench.min")}</span>
              </div>
            </div>
          </div>

          <div class="rounded-xl border border-slate-200 bg-white p-4">
            <div class="flex items-center gap-2">
              <Icon name="cpu" class="w-4 h-4 text-accent-600" />
              <span class="text-sm font-semibold text-slate-700">{t("hero.bench.gpuLabel")}</span>
              <span class="font-mono text-xs text-slate-500"
                >NVIDIA GeForce RTX 4060 Laptop GPU</span
              >
            </div>
            <p class="mt-2 text-sm leading-relaxed text-slate-500">{t("hero.bench.gpuNote")}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
