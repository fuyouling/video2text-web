---
import { getRelativeLocaleUrl } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative overflow-hidden bg-gradient-to-b from-brand-50 to-white">
  <div class="container-page grid items-center gap-12 py-16 lg:grid-cols-2 lg:py-24">
    <div>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100 px-3 py-1 text-sm font-medium text-brand-700">
        <Icon name="shield" class="w-4 h-4" />
        {t('hero.badge')}
      </span>
      <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        {t('hero.title')}
      </h1>
      <p class="mt-5 max-w-xl text-lg text-slate-600">{t('hero.subtitle')}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={getRelativeLocaleUrl(lang, 'download')}
          class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-5 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-brand-700"
        >
          <Icon name="download" class="w-5 h-5" />
          {t('hero.ctaPrimary')}
        </a>
        <a
          href={getRelativeLocaleUrl(lang, 'docs')}
          class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-5 py-3 text-base font-semibold text-slate-700 transition hover:border-slate-400"
        >
          <Icon name="fileText" class="w-5 h-5" />
          {t('hero.ctaSecondary')}
        </a>
      </div>
      <p class="mt-4 text-sm text-slate-500">{t('hero.note')}</p>
    </div>

    <div class="relative">
      <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xl">
        <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
          <span class="h-3 w-3 rounded-full bg-red-400"></span>
          <span class="h-3 w-3 rounded-full bg-yellow-400"></span>
          <span class="h-3 w-3 rounded-full bg-green-400"></span>
          <span class="ml-2 text-xs text-slate-400">video2text</span>
        </div>
        <div class="mt-4 space-y-3">
          <div class="h-3 w-2/3 rounded bg-slate-100"></div>
          <div class="h-3 w-full rounded bg-slate-100"></div>
          <div class="h-3 w-5/6 rounded bg-slate-100"></div>
          <div class="rounded-lg bg-brand-50 p-3">
            <div class="h-2.5 w-1/3 rounded bg-brand-200"></div>
            <div class="mt-2 h-2.5 w-full rounded bg-brand-100"></div>
            <div class="mt-2 h-2.5 w-4/5 rounded bg-brand-100"></div>
          </div>
          <div class="flex items-center gap-2 pt-1">
            <span class="inline-flex items-center gap-1 rounded-full bg-accent-500/10 px-2 py-1 text-xs font-medium text-accent-600">
              <Icon name="cpu" class="w-3.5 h-3.5" /> GPU
            </span>
            <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600">
              <Icon name="languages" class="w-3.5 h-3.5" /> auto
            </span>
            <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600">
              <Icon name="shield" class="w-3.5 h-3.5" /> local
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
