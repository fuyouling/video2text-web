---
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const steps: { icon: Parameters<typeof Icon>[0]["name"]; title: string; desc: string }[] = [
  { icon: "fileText", title: t("workflow.step1.title"), desc: t("workflow.step1.desc") },
  { icon: "download", title: t("workflow.step2.title"), desc: t("workflow.step2.desc") },
  { icon: "cpu", title: t("workflow.step3.title"), desc: t("workflow.step3.desc") },
  { icon: "sparkles", title: t("workflow.step4.title"), desc: t("workflow.step4.desc") },
  { icon: "check", title: t("workflow.step5.title"), desc: t("workflow.step5.desc") },
];
---

<section class="bg-white py-16">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="h-title text-3xl font-bold tracking-tight text-slate-900">{t("workflow.title")}</h2>
      <p class="sub mt-3 text-slate-600">{t("workflow.subtitle")}</p>
    </div>

    <ol class="mt-12 grid gap-6 md:grid-cols-5">
      {
        steps.map((s, i) => (
          <li class="relative rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-brand-600 text-sm font-semibold text-white">
              {i + 1}
            </span>
            <div class="mt-3 text-brand-600">
              <Icon name={s.icon} class="w-5 h-5" />
            </div>
            <h3 class="h-title mt-2 text-base font-semibold text-slate-900">{s.title}</h3>
            <p class="copy mt-1 text-sm text-slate-600">{s.desc}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
