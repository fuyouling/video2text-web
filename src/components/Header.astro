---
import { getRelativeLocaleUrl } from "../i18n/utils";
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";
import Icon from "./Icon.astro";
import LangSwitch from "./LangSwitch.astro";
import { PUBLIC_RELEASE_REPO } from "../lib/env";

interface NavItem {
  href: string;
  key: "nav.features" | "nav.docs" | "nav.blog" | "nav.pricing" | "nav.contact";
}

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);

const items: NavItem[] = [
  { href: getRelativeLocaleUrl(lang, "features"), key: "nav.features" },
  { href: getRelativeLocaleUrl(lang, "docs"), key: "nav.docs" },
  { href: getRelativeLocaleUrl(lang, "blog"), key: "nav.blog" },
  { href: getRelativeLocaleUrl(lang, "pricing"), key: "nav.pricing" },
  { href: getRelativeLocaleUrl(lang, "contact"), key: "nav.contact" },
];

const githubRepo = `https://github.com/${PUBLIC_RELEASE_REPO}`;
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/80 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a
      href={getRelativeLocaleUrl(lang, "")}
      class="flex items-center gap-2 font-bold text-slate-900"
    >
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-600 text-white">V</span>
      <span>video2text</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        items.map((it) => (
          <a
            href={it.href}
            class="no-jitter rounded-md px-3 py-2 text-sm font-medium text-slate-600 transition hover:text-brand-600"
          >
            {t(it.key)}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <LangSwitch lang={lang} path={path} />
      <a
        href={githubRepo}
        target="_blank"
        rel="noopener noreferrer"
        class="no-jitter inline-flex items-center gap-1.5 rounded-md border border-slate-200 px-3 py-2 text-sm font-medium text-slate-700 transition hover:border-slate-300"
        aria-label="GitHub"
      >
        <Icon name="github" class="w-4 h-4" />
        <span>GitHub</span>
      </a>
      <a
        href={getRelativeLocaleUrl(lang, "register")}
        class="no-jitter inline-flex items-center gap-1.5 rounded-md bg-brand-600 px-3.5 py-2 text-sm font-semibold text-white transition hover:bg-brand-700"
      >
        <Icon name="userPlus" class="w-4 h-4" />
        {t("nav.register")}
      </a>
    </div>

    <button
      id="menu-toggle"
      class="inline-flex items-center justify-center rounded-md p-2 text-slate-700 md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" class="w-6 h-6" />
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-slate-200 bg-white md:hidden"
    data-lang={lang}
    data-path={path}
  >
    <nav class="container-page flex flex-col gap-1 py-4" aria-label="Mobile">
      {
        items.map((it) => (
          <a
            href={it.href}
            class="rounded-md px-3 py-2 text-base font-medium text-slate-700 hover:bg-slate-50"
          >
            {t(it.key)}
          </a>
        ))
      }
      <div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-4">
        <LangSwitch lang={lang} path={path} />
        <a
          href={githubRepo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm text-slate-700"
        >
          <Icon name="github" class="w-4 h-4" /> GitHub
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  import { initMobileMenu } from "../scripts/menu";
  const root = document.getElementById("mobile-menu");
  const toggle = document.getElementById("menu-toggle");
  if (root && toggle) initMobileMenu(root, toggle);
</script>
