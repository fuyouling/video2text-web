---
import { localizedPath } from "../i18n/utils";
import { ALL_LANGS } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  path: string;
  class?: string;
}

const { lang, path, class: klass = "" } = Astro.props;

// 各语言的原生名称，用于语言切换下拉
const LANG_NAMES: Record<Lang, string> = {
  en: "English",
  zh: "简体中文",
  "zh-TW": "繁體中文",
  de: "Deutsch",
  es: "Español",
  fr: "Français",
  ja: "日本語",
  ko: "한국어",
  ru: "Русский",
};

const options = ALL_LANGS.map((code) => ({
  code,
  name: LANG_NAMES[code],
  url: localizedPath(path, code),
  current: code === lang,
}));
---

<div class={`relative inline-block text-sm ${klass}`}>
  <label class="sr-only" for="lang-switch">{lang === "zh" ? "语言" : "Language"}</label>
  <select
    id="lang-switch"
    aria-label={lang === "zh" ? "语言" : "Language"}
    class="cursor-pointer rounded-full border border-slate-200 bg-white py-1.5 pl-3 pr-8 text-slate-700 outline-none transition hover:border-brand-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-100"
    onchange="window.location.href=this.value"
  >
    {
      options.map((o) => (
        <option value={o.url} selected={o.current}>
          {o.name}
        </option>
      ))
    }
  </select>
</div>
