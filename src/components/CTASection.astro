---
import { getRelativeLocaleUrl } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  title?: string;
  subtitle?: string;
}

const { lang, title, subtitle } = Astro.props;
const t = useTranslations(lang);
---

<section class="border-y border-slate-200 bg-brand-600">
  <div class="container-page flex flex-col items-center justify-between gap-6 py-12 text-center sm:flex-row sm:text-left">
    <div class="text-white">
      <h2 class="text-2xl font-bold">{title ?? t('hero.ctaPrimary')}</h2>
      {subtitle && <p class="mt-2 text-brand-100">{subtitle}</p>}
    </div>
    <div class="flex flex-wrap gap-3">
      <a
        href={getRelativeLocaleUrl(lang, 'download')}
        class="inline-flex items-center gap-2 rounded-lg bg-white px-5 py-3 text-base font-semibold text-brand-700 transition hover:bg-brand-50"
      >
        <Icon name="download" class="w-5 h-5" />
        {t('cta.download')}
      </a>
      <a
        href={getRelativeLocaleUrl(lang, 'features')}
        class="inline-flex items-center gap-2 rounded-lg border border-white/40 px-5 py-3 text-base font-semibold text-white transition hover:bg-white/10"
      >
        {t('cta.learnMore')}
        <Icon name="arrowRight" class="w-5 h-5" />
      </a>
    </div>
  </div>
</section>
