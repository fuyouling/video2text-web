---
import type { GetStaticPaths } from 'astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { fetchLatestRelease, parseDownloadAssets, fallbackVersion } from '../../lib/github';
import { PUBLIC_RELEASE_REPO } from '../../lib/env';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DownloadButton from '../../components/DownloadButton.astro';
import CTASection from '../../components/CTASection.astro';

export const getStaticPaths = (async () => {
  // 构建期拉取一次 Release（失败兜底，不抛错，保证 build 可成功）
  const release = await fetchLatestRelease();
  const version = release?.tag_name ?? fallbackVersion();
  const assets = release ? parseDownloadAssets(release) : [];
  return [
    { params: { lang: 'en' }, props: { lang: 'en', version, assets } },
    { params: { lang: 'zh' }, props: { lang: 'zh', version, assets } },
  ];
}) satisfies GetStaticPaths;

const { lang, version, assets } = Astro.props as {
  lang: Lang;
  version: string;
  assets: import('../../lib/github').DownloadAsset[];
};
const t = useTranslations(lang);
const path = Astro.url.pathname;
---

<BaseLayout lang={lang} path={path} title={`video2text — ${t('download.title')}`} description={t('download.subtitle')}>
  <section class="bg-white py-16">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900">{t('download.title')}</h1>
        <p class="mt-3 text-lg text-slate-600">{t('download.subtitle')}</p>
      </div>

      <div class="mx-auto mt-12 max-w-3xl">
        <DownloadButton version={version} assets={assets} lang={lang} repo={PUBLIC_RELEASE_REPO} />

        <div class="mt-12 rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <h2 class="text-lg font-semibold text-slate-900">{t('download.requirements.title')}</h2>
          <p class="mt-2 text-sm text-slate-600">{t('download.requirements.body')}</p>
        </div>
      </div>
    </div>
  </section>
  <CTASection lang={lang} />
</BaseLayout>
