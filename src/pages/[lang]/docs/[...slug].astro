---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import { useTranslations, localeForLang } from "../../../i18n/utils";
import type { Lang } from "../../../i18n/ui";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export const getStaticPaths = (async () => {
  const docs = await getCollection("docs");
  const langs: Lang[] = ["en", "zh"];
  return langs.flatMap((lang) =>
    docs
      .filter((d) => d.data.lang === lang)
      .sort((a, b) => a.data.order - b.data.order)
      .map((d) => ({
        params: { lang, slug: d.slug },
        props: { lang, entry: d },
      })),
  );
}) satisfies GetStaticPaths;

const { lang, entry } = Astro.props as {
  lang: Lang;
  entry: import("astro:content").CollectionEntry<"docs">;
};
const t = useTranslations(lang);
const path = Astro.url.pathname;
const { Content } = await entry.render();
---

<BaseLayout
  lang={lang}
  path={path}
  title={`video2text — ${entry.data.title}`}
  description={entry.data.description ?? t("docs.subtitle")}
>
  <section class="bg-white py-16">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <a href={`/${lang}/docs`} class="text-sm text-brand-600 hover:underline"
          >← {t("nav.docs")}</a
        >
        <h1 class="h-hero mt-3 text-4xl font-extrabold tracking-tight text-slate-900">
          {entry.data.title}
        </h1>
        {entry.data.pubDate && (
          <p class="mt-2 text-sm text-slate-400">
            {entry.data.pubDate.toLocaleDateString(localeForLang(lang), {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </p>
        )}
        <article class="prose mt-8 max-w-none">
          <Content />
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
