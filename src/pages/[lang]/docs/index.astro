---
export { getStaticPaths } from "../../../lib/i18n-paths";
import { getCollection } from "astro:content";
import { useTranslations, localeForLang, baseSlug, getRelativeLocaleUrl } from "../../../i18n/utils";
import type { Lang } from "../../../i18n/ui";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const path = Astro.url.pathname;

const entries = (await getCollection("docs", (e) => e.data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  lang={lang}
  path={path}
  title={`video2text - ${t("meta.docs")}`}
  description={t("docs.subtitle")}
>
  <section class="bg-white py-16">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <h1 class="h-title text-4xl font-extrabold tracking-tight text-slate-900">{t("docs.title")}</h1>
        <p class="mt-3 text-lg text-slate-600">{t("docs.subtitle")}</p>

        {
          entries.length === 0 ? (
            <p class="mt-10 text-slate-500">{t("docs.empty")}</p>
          ) : (
            <ul class="mt-10 divide-y divide-slate-100">
              {entries.map((e) => (
                <li>
                  <a
                    href={getRelativeLocaleUrl(lang, `docs/${baseSlug(e.slug)}`)}
                    class="block py-4 transition hover:text-brand-600"
                  >
                    <span class="text-lg font-semibold text-slate-900">{e.data.title}</span>
                    {e.data.description && (
                      <p class="mt-1 text-sm text-slate-500">{e.data.description}</p>
                    )}
                    {e.data.pubDate && (
                      <p class="mt-1 text-xs text-slate-400">
                        {e.data.pubDate.toLocaleDateString(localeForLang(lang))}
                      </p>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
