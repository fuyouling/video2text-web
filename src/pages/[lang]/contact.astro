---
export { getStaticPaths } from "../../lib/i18n-paths";
import { useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { PUBLIC_RELEASE_REPO } from "../../lib/env";

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const path = Astro.url.pathname;
const githubRepo = `https://github.com/${PUBLIC_RELEASE_REPO}`;
const email = "admin@video2text.dpdns.org";
---

<BaseLayout
  lang={lang}
  path={path}
  title={`video2text - ${t("meta.contact")}`}
  description={t("contact.subtitle")}
>
  <section class="bg-white py-16">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="h-title text-4xl font-extrabold tracking-tight text-slate-900">{t("contact.title")}</h1>
        <p class="mt-3 text-lg text-slate-600">{t("contact.subtitle")}</p>
      </div>

      <div class="mx-auto mt-12 grid max-w-3xl gap-4 sm:grid-cols-3">
        <a
          href={githubRepo}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center rounded-2xl border border-slate-200 bg-white p-6 text-center transition hover:border-brand-300"
        >
          <Icon name="github" class="w-7 h-7 text-brand-600" />
          <span class="mt-3 font-medium text-slate-900">{t("contact.github.label")}</span>
        </a>
        <div
          class="flex flex-col items-center rounded-2xl border border-slate-200 bg-white p-6 text-center transition hover:border-brand-300"
        >
          <button
            type="button"
            class="copy-email-btn flex flex-col items-center"
            data-email={email}
            aria-label={t("contact.email.copy")}
          >
            <Icon name="fileText" class="w-7 h-7 text-brand-600" />
            <span class="mt-3 font-medium text-slate-900">{t("contact.email.label")}</span>
          </button>
          <a
            href={`mailto:${email}`}
            class="mt-1 text-sm text-slate-500 underline-offset-2 hover:underline"
            >{email}</a
          >
          <span class="copy-email-status mt-2 text-xs font-medium text-brand-600" aria-live="polite"
          ></span>
        </div>
        <a
          href={`${githubRepo}/issues`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center rounded-2xl border border-slate-200 bg-white p-6 text-center transition hover:border-brand-300"
        >
          <Icon name="download" class="w-7 h-7 text-brand-600" />
          <span class="mt-3 font-medium text-slate-900">{t("contact.issues.label")}</span>
        </a>
      </div>
    </div>
  </section>

  <script
    define:vars={{
      copyText: t("contact.email.copy"),
      copiedText: t("contact.email.copied"),
    }}
  >
    const btn = document.querySelector(".copy-email-btn");
    const status = document.querySelector(".copy-email-status");
    if (btn && status) {
      btn.addEventListener("click", async () => {
        const email = btn.getAttribute("data-email") ?? "";
        try {
          await navigator.clipboard.writeText(email);
          status.textContent = copiedText;
          setTimeout(() => (status.textContent = ""), 1500);
        } catch {
          /* 剪贴板不可用时忽略 */
        }
      });
    }
  </script>
</BaseLayout>
