---
export { getStaticPaths } from "../../lib/i18n-paths";
import { useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { PUBLIC_RELEASE_REPO } from "../../lib/env";

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const path = Astro.url.pathname;
const githubRepo = `https://github.com/${PUBLIC_RELEASE_REPO}`;
const email = "admin@video2text.dpdns.org";
---

<BaseLayout
  lang={lang}
  path={path}
  title={`video2text - ${t("meta.contact")}`}
  description={t("contact.subtitle")}
>
  <section class="bg-white py-16">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="h-title text-4xl font-extrabold tracking-tight text-slate-900">{t("contact.title")}</h1>
        <p class="mt-3 text-lg text-slate-600">{t("contact.subtitle")}</p>
      </div>

      <div class="mx-auto mt-12 grid max-w-3xl gap-4 sm:grid-cols-3">
        <a
          href={githubRepo}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center rounded-2xl border border-slate-200 bg-white p-6 text-center transition hover:border-brand-300"
        >
          <Icon name="github" class="w-7 h-7 text-brand-600" />
          <span class="mt-3 font-medium text-slate-900">{t("contact.github.label")}</span>
        </a>
        <a
          href={`mailto:${email}`}
          class="flex flex-col items-center rounded-2xl border border-slate-200 bg-white p-6 text-center transition hover:border-brand-300"
        >
          <Icon name="fileText" class="w-7 h-7 text-brand-600" />
          <span class="mt-3 font-medium text-slate-900">{t("contact.email.label")}</span>
          <span class="mt-1 text-sm text-slate-500">{email}</span>
        </a>
        <a
          href={`${githubRepo}/issues`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center rounded-2xl border border-slate-200 bg-white p-6 text-center transition hover:border-brand-300"
        >
          <Icon name="download" class="w-7 h-7 text-brand-600" />
          <span class="mt-3 font-medium text-slate-900">{t("contact.issues.label")}</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
