---
export { getStaticPaths } from '../../lib/i18n-paths';
import { useTranslations, getRelativeLocaleUrl } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const path = Astro.url.pathname;
const loginUrl = getRelativeLocaleUrl(lang, 'login');
const homeUrl = getRelativeLocaleUrl(lang, '');
---

<BaseLayout lang={lang} path={path} title={`video2text — ${t('auth.register.title')}`} description={t('auth.register.subtitle')}>
  <section class="bg-gradient-to-b from-brand-50 to-white py-16">
    <div class="container-page">
      <div class="mx-auto w-full max-w-md">
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-xl">
          <div class="flex flex-col items-center text-center">
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-brand-600 text-lg font-bold text-white">V</span>
            <h1 class="mt-4 text-2xl font-extrabold tracking-tight text-slate-900">{t('auth.register.title')}</h1>
            <p class="mt-1.5 text-sm text-slate-500">{t('auth.register.subtitle')}</p>
          </div>

          <form
            id="register-form"
            class="mt-8 space-y-5"
            novalidate
            data-login-url={loginUrl}
            data-msg-required={t('auth.register.errorRequired')}
            data-msg-email={t('auth.register.errorEmail')}
            data-msg-password={t('auth.register.errorPassword')}
            data-msg-conflict={t('auth.register.errorConflict')}
            data-msg-generic={t('auth.register.errorGeneric')}
          >
            <div>
              <label for="email" class="block text-sm font-medium text-slate-700">{t('auth.register.emailLabel')}</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100"
              />
            </div>
            <div>
              <label for="password" class="block text-sm font-medium text-slate-700">{t('auth.register.passwordLabel')}</label>
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="new-password"
                required
                minlength="8"
                class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-900 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100"
              />
            </div>

            <p id="form-error" class="hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700" role="alert"></p>

            <button
              type="submit"
              id="submit-btn"
              class="inline-flex w-full items-center justify-center rounded-lg bg-brand-600 px-5 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-brand-700 disabled:opacity-60"
            >
              {t('auth.register.submit')}
            </button>
          </form>

          <p class="mt-6 text-center text-sm text-slate-500">
            {t('auth.register.haveAccount')}
            <a href={loginUrl} class="font-medium text-brand-600 hover:underline">{t('auth.register.loginLink')}</a>
          </p>
        </div>

        <p class="mt-6 text-center text-sm">
          <a href={homeUrl} class="text-slate-400 transition hover:text-slate-600">{t('common.backHome')}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { register } from '../../lib/api';
  import type { ApiClientError } from '../../lib/api';

  const form = document.getElementById('register-form') as HTMLFormElement | null;
  if (form) {
    const emailEl = form.elements.namedItem('email') as HTMLInputElement;
    const passwordEl = form.elements.namedItem('password') as HTMLInputElement;
    const errorEl = document.getElementById('form-error') as HTMLElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    const defaultLabel = submitBtn.textContent ?? '';
    const loginUrl = form.dataset.loginUrl ?? '/login';
    const msg = {
      required: form.dataset.msgRequired ?? 'Please fill in all fields.',
      email: form.dataset.msgEmail ?? 'Please enter a valid email address.',
      password: form.dataset.msgPassword ?? 'Password must be at least 8 characters.',
      conflict: form.dataset.msgConflict ?? 'An account with this email already exists.',
      generic: form.dataset.msgGeneric ?? 'Something went wrong. Please try again.',
    };

    const showError = (text: string) => {
      errorEl.textContent = text;
      errorEl.classList.remove('hidden');
    };
    const clearError = () => {
      errorEl.textContent = '';
      errorEl.classList.add('hidden');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError();

      const email = emailEl.value.trim();
      const password = passwordEl.value;

      if (!email || !password) return showError(msg.required);
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showError(msg.email);
      if (password.length < 8) return showError(msg.password);

      submitBtn.disabled = true;
      submitBtn.textContent = '…';
      try {
        await register({ email, password });
        // 注册成功后跳转到登录页，并预填邮箱
        const sep = loginUrl.includes('?') ? '&' : '?';
        window.location.href = loginUrl + sep + 'email=' + encodeURIComponent(email);
      } catch (err) {
        const code = (err as ApiClientError).code;
        if (code === 'conflict') showError(msg.conflict);
        else if (code === 'validation_error') showError(msg.email);
        else showError(msg.generic);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = defaultLabel;
      }
    });
  }
</script>
