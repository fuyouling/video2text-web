---
export { getStaticPaths } from "../../lib/i18n-paths";
import { useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FeatureCard from "../../components/FeatureCard.astro";
import CTASection from "../../components/CTASection.astro";
import Icon from "../../components/Icon.astro";

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const path = Astro.url.pathname;

const details: { icon: Parameters<typeof Icon>[0]["name"]; title: string; desc: string }[] = [
  { icon: "shield", title: t("features.local.title"), desc: t("features.local.desc") },
  { icon: "cpu", title: t("features.gpu.title"), desc: t("features.gpu.desc") },
  { icon: "languages", title: t("features.multilang.title"), desc: t("features.multilang.desc") },
  { icon: "sparkles", title: t("features.summary.title"), desc: t("features.summary.desc") },
  { icon: "box", title: t("features.models.title"), desc: t("features.models.desc") },
  { icon: "monitor", title: t("features.desktop.title"), desc: t("features.desktop.desc") },
];
---

<BaseLayout
  lang={lang}
  path={path}
  title={`video2text — ${t("features.title")}`}
  description={t("features.subtitle")}
>
  <section class="bg-white py-16">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900">{t("features.title")}</h1>
        <p class="mt-3 text-lg text-slate-600">{t("features.subtitle")}</p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {details.map((d) => <FeatureCard icon={d.icon} title={d.title} desc={d.desc} />)}
      </div>
    </div>
  </section>
  <CTASection lang={lang} />
</BaseLayout>
